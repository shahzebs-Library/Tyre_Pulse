  "footer": {
    "lines": [
      "Every time on this notice is set by the server when the action was recorded. Records are append-only: a wrong charge is reversed and reissued, never edited after the driver is notified.",
      "A deduction is made only after the driver gave written consent, or after a witnessed refusal or dispute was reviewed by two different people and the appeal period ended or an appeal was decided by a third person. No monthly instalment exceeds the limit shown in section 8.",
      "Charges on drivers in Saudi Arabia follow the Saudi Labour Law (Royal Decree M/51): damage or loss at most 5 days' wage a month and 15 working days to object (Article 91), any other deduction, including a traffic fine, only with written consent (Article 92), and all deductions together at most half the wage (Article 93; only deductions recorded in Tyre Pulse are counted)."
    ],
    "page_number": "Page {page} of {pages}"
  },
  "driver_notice": {
    "rule": "Printed near the top in the driver's language: the language of the driver's latest signature, else the language the app is set to, else English. Placeholders: {amount} is the charge amount with currency, {window} is the objection window, {deadline} is the last day to object or the pending phrase.",
    "text": {
      "en": {
        "dir": "ltr",
        "title": "What this paper means for you",
        "lines": [
          "The company says you must pay {amount} for this charge. Read the reason in section 3 and look at the photos in section 4a.",
          "If you agree, sign the consent. If you do not agree, sign that you received this paper and write why.",
          "You can object within {window} after finance approves the charge. Last day: {deadline}.",
          "Two different people must approve before anything is taken from your salary."
        ],
        "window_statutory": "15 working days (Sunday to Thursday)",
        "window_days": "{days} days",
        "deadline_pending": "set when finance approves"
      },
      "ar": {
        "dir": "rtl",
        "title": "ماذا تعني هذه الورقة بالنسبة لك",
        "lines": [
          "تقول الشركة إنك ملزم بدفع {amount} عن هذه المطالبة. اقرأ السبب في القسم 3 وانظر إلى الصور في القسم 4a.",
          "إذا كنت موافقا، وقع على الموافقة. وإذا لم تكن موافقا، وقع على أنك استلمت هذه الورقة واكتب السبب.",
          "يحق لك الاعتراض خلال {window} بعد موافقة المالية على المطالبة. آخر يوم: {deadline}.",
          "يجب أن يوافق شخصان مختلفان قبل أن يخصم أي شيء من راتبك."
        ],
        "window_statutory": "15 يوم عمل (من الأحد إلى الخميس)",
        "window_days": "{days} أيام",
        "deadline_pending": "يحدد عند موافقة المالية"
      },
      "ur": {
        "dir": "rtl",
        "title": "یہ کاغذ آپ کے لیے کیا معنی رکھتا ہے",
        "lines": [
          "کمپنی کہتی ہے کہ آپ کو اس چارج کے لیے {amount} ادا کرنا ہے۔ وجہ سیکشن 3 میں پڑھیں اور تصویریں سیکشن 4a میں دیکھیں۔",
          "اگر آپ متفق ہیں تو اجازت پر دستخط کریں۔ اگر متفق نہیں ہیں تو دستخط کریں کہ آپ کو یہ کاغذ مل گیا ہے اور وجہ لکھیں۔",
          "آپ فنانس کی منظوری کے بعد {window} کے اندر اعتراض کر سکتے ہیں۔ آخری دن: {deadline}۔",
          "آپ کی تنخواہ سے کچھ کاٹنے سے پہلے دو مختلف لوگوں کی منظوری ضروری ہے۔"
        ],
        "window_statutory": "15 کام کے دن (اتوار سے جمعرات)",
        "window_days": "{days} دن",
        "deadline_pending": "فنانس کی منظوری پر طے ہو گا"
      }
    }
  }
