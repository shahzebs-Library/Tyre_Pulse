{
  "id": "driver-charge-notice",
  "spec_version": 2,
  "title": "Driver Charge Notice",
  "description": "Complete record of one charge recoverable from a driver. Web (src/lib/driverChargePdf.js) and Flutter render this same spec from the payload returned by the driver_charge_detail RPC. Renderers must not add, drop or reorder fields.",
  "data_source": "rpc:driver_charge_detail(p_charge_id) plus generated_at (client clock, ISO 8601)",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "unit": "mm",
    "margin": 14
  },
  "document_number": {
    "format": "{charge.charge_no}-V{charge.version}",
    "example": "DC-2026-00001-V7",
    "rule": "charge_no is minted by the server as DC-YYYY-NNNNN per organisation. The version suffix changes on every recorded action, so two printouts with the same number are the same record state."
  },
  "header": {
    "title": "Driver Charge Notice",
    "lines": [
      "Document no. {document_number}",
      "Generated {generated_at:datetime}. Status at generation: {charge.status:enum:status}"
    ]
  },
  "formats": {
    "missing": "Not recorded",
    "money": "{currency} {amount} with 2 decimals; amounts of different currencies are never added together",
    "datetime": "Local date and time with the timezone offset, for example 2026-01-05 14:20 GMT+3",
    "date": "YYYY-MM-DD",
    "month": "Month YYYY, for example January 2026",
    "boolean": "Yes or No",
    "percent": "Number followed by %"
  },
  "enums": {
    "category": {
      "traffic_fine": "Traffic fine",
      "accident_damage": "Accident damage",
      "tyre_damage": "Tyre damage",
      "missing_item": "Missing item",
      "handover_damage": "Handover damage",
      "other": "Other"
    },
    "source_type": {
      "accident": "Accident case",
      "handover_report": "Vehicle handover",
      "inspection": "Inspection",
      "checklist_submission": "Checklist",
      "tyre_record": "Tyre record",
      "driver_fine": "Traffic fine record",
      "none": "No linked record"
    },
    "link_check": {
      "true": "Link to source not confirmed by record",
      "false": "Driver named in the linked record"
    },
    "status": {
      "issued": "Issued, driver not yet notified",
      "notified": "Notified, waiting for driver",
      "accepted": "Accepted by driver",
      "disputed": "Disputed by driver",
      "refused": "Driver refused to sign (witnessed)",
      "supervisor_approved": "Approved by supervisor",
      "finance_approved": "Approved by finance",
      "under_appeal": "Under appeal",
      "scheduled": "Deduction scheduled",
      "deducted": "Fully deducted",
      "waived": "Waived",
      "cancelled_wrongly_issued": "Cancelled, wrongly issued"
    },
    "driver_response": {
      "accepted": "Accepted and consented",
      "disputed": "Disputed",
      "refused": "Refused to sign"
    },
    "decision_stage": {
      "supervisor": "Supervisor review",
      "finance": "Finance review",
      "appeal": "Appeal decision",
      "waiver": "Waiver",
      "reversal": "Reversal",
      "deduction": "Payroll deduction",
      "schedule": "Deduction schedule"
    },
    "decision": {
      "approve": "Approved",
      "return": "Returned",
      "upheld": "Charge upheld",
      "allowed": "Appeal allowed, charge waived",
      "waive": "Waived",
      "reverse": "Reversed as wrongly issued",
      "deducted": "Deducted",
      "scheduled": "Scheduled"
    },
    "reversal_code": {
      "wrong_driver": "Wrong driver",
      "duplicate": "Duplicate",
      "wrong_amount": "Wrong amount",
      "wrong_vehicle": "Wrong vehicle",
      "misused": "Misused or improper charge",
      "other": "Other"
    },
    "instalment_status": {
      "scheduled": "Scheduled",
      "deducted": "Deducted",
      "cancelled": "Cancelled"
    },
    "appeal_outcome": {
      "upheld": "Charge upheld",
      "allowed": "Appeal allowed"
    },
    "action": {
      "charge_issue": "Charge issued",
      "charge_correct": "Corrected before notice",
      "charge_attach_evidence": "Evidence added",
      "charge_notify": "Driver notified",
      "charge_respond": "Driver responded and signed",
      "charge_record_refusal": "Refusal recorded, waiting for witness",
      "charge_witness_confirm": "Refusal confirmed by witness",
      "charge_supervisor_review": "Supervisor review",
      "charge_finance_review": "Finance review",
      "charge_schedule": "Deduction scheduled",
      "charge_record_deduction": "Payroll deduction recorded",
      "charge_waive": "Charge waived",
      "charge_reverse": "Reversed as wrongly issued",
      "charge_reissued_in": "Reissued from a reversed charge",
      "charge_appeal": "Appeal filed",
      "charge_decide_appeal": "Appeal decided"
    },
    "signature_kind": {
      "driver_acceptance": "Driver written consent to deduction",
      "driver_dispute": "Driver receipt and dispute",
      "refusal_witness": "Witness to refusal"
    },
    "schedule_rule": {
      "ksa_labour_law": "Saudi Labour Law (Royal Decree M/51), Articles 70, 71, 91, 92 and 93",
      "company_setting": "Company setting (needs legal confirmation for this country)"
    },
    "language": {
      "en": "English",
      "ar": "Arabic",
      "ur": "Urdu"
    }
  },
