# Where the Login button and the customer login link point.
#
# app.tyrepulse.app does NOT exist yet. The only configured domains are
# tyrepulse.app and www.tyrepulse.app, and both are attached to the Vercel
# project that serves the operational app, so www is the host that actually
# answers today. README.md has the ordered steps for the intended split;
# switch this line to https://app.tyrepulse.app on the day that host is live.
#
# Leaving it unset is fine: lib/site.ts carries the same default.
NEXT_PUBLIC_APP_URL=https://www.tyrepulse.app

# This marketing site's own canonical origin, used for canonical URLs,
# hreflang, the sitemap and the JSON-LD graph.
NEXT_PUBLIC_SITE_URL=https://www.tyrepulse.app

# Contact form delivery (Resend). Server-only: never prefix these with
# NEXT_PUBLIC_. Missing configuration makes the form return 503 rather than
# silently accepting a message it cannot deliver.
CONTACT_TO_EMAIL=sales@tyrepulse.app
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
