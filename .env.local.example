# ── AI / Anthropic key — SERVER SIDE ONLY ────────────────────────────────────
# Do NOT add VITE_ANTHROPIC_API_KEY. All AI runs through the `chat-ai` Supabase
# Edge Function, which reads ANTHROPIC_API_KEY from Edge Function secrets:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   # or: Dashboard → Edge Functions → Manage secrets → add ANTHROPIC_API_KEY
#
# (The same applies to send-email's SMTP creds and SUPABASE_SERVICE_ROLE_KEY —
#  Edge Function secrets only, never VITE_*.)

# ── Accident & Insurance Module ─────────────────────────────────────────────
# Enable the Accident module features (set to true/false)
VITE_FEATURE_ACCIDENTS=true
# (Optional) External API integrations for the accident module (e.g., Najm, Traffic Police)
# Do NOT put secret keys here. Use Supabase Edge Function secrets for API keys.
VITE_ACCIDENT_AUTHORITY_API_URL=

# ── Washing Module ──────────────────────────────────────────────────────────
# Enable the Washing module features (set to true/false)
VITE_FEATURE_WASHING=true
VITE_WASHING_STATION_SYNC_ENABLED=false
