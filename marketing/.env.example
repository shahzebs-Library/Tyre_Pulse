# Where "Log in", the customer login link, the legal pages (/privacy, /terms,
# /data-deletion) and the /console redirect point. The operational app is served
# at app.tyrepulse.app, and lib/site.ts carries the same default, so leaving
# this unset is fine.
NEXT_PUBLIC_APP_URL=https://app.tyrepulse.app

# This marketing site's own canonical origin, used for canonical URLs,
# hreflang, the sitemap and the JSON-LD graph.
NEXT_PUBLIC_SITE_URL=https://www.tyrepulse.app

# Contact form delivery (Resend). Server-only: never prefix these with
# NEXT_PUBLIC_. Missing configuration makes the form return 503 rather than
# silently accepting a message it cannot deliver.
CONTACT_TO_EMAIL=info@tyrepulse.app
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
